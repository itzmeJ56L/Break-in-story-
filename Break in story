local function handleLocalToolCreation(itemName)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		local tool = Instance.new("Tool")
		tool.Name = itemName
		local handle = Instance.new("Part")
		handle.Name = "Handle"
		handle.Size = Vector3.new(1, 1, 1)
		handle.Parent = tool
		tool.Parent = backpack
	end
end

local function createColumn(name, xPosition, itemsList)
	local container = Instance.new("Frame")
	container.Size = UDim2.new(0.31, 0, 1, -115)
	container.Position = UDim2.new(xPosition, 0, 0, 105)
	container.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	container.Parent = displayWindow
	
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Thickness = 2
	stroke.Parent = container
	
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 0, 25)
	lbl.BackgroundTransparency = 1
	lbl.Text = name
	lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	lbl.Font = Enum.Font.SourceSans
	lbl.TextSize = 20
	lbl.Parent = container
	
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -10, 1, -35)
	scroll.Position = UDim2.new(0, 5, 0, 30)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.Parent = container
	
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.Parent = scroll
	
	for _, item in ipairs(itemsList) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -5, 0, 28)
		btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
		btn.Text = item
		btn.TextColor3 = Color3.fromRGB(200, 200, 200)
		btn.Font = Enum.Font.SourceSans
		btn.TextSize = 14
		btn.Parent = scroll
		
		local bStroke = Instance.new("UIStroke")
		bStroke.Color = Color3.fromRGB(70, 70, 70)
		bStroke.Thickness = 1
		bStroke.Parent = btn
		
		btn.MouseButton1Click:Connect(function()
			handleLocalToolCreation(item)
		end)
		
		btn.MouseButton2Click:Connect(function()
			local backpack = player:FindFirstChildOfClass("Backpack")
			if backpack then
				local tool = backpack:FindFirstChild(item)
				if tool then tool:Destroy() end
			end
			if player.Character then
				local equipped = player.Character:FindFirstChild(item)
				if equipped and equipped:IsA("Tool") then equipped:Destroy() end
			end
		end)
	end
	scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 5)
end

